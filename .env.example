# Database Configuration (SQLite default)
DATABASE_URL="file:./drivecloud.db"

# Server Configuration
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Cloud OAuth 2.0 Credentials
# Obtain these from Google Cloud Console (https://console.cloud.google.com)
# Enable "Google Drive API" and create OAuth Client ID (Web Application)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Security & Encryption
# Generate a 32-byte hex key for encrypting stored Google OAuth refresh tokens:
# Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
